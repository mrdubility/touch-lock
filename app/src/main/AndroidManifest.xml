<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮窗：在全屏覆盖层拦截触摸 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务：保证锁定期间进程不被回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 显示前台服务通知需要 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      权限边界（保持最小，新增前请先评估必要性）：
      以上 4 项即全部。本项目不申请：剪贴板读写、传感器/设备动作方向、
      安装快捷方式（桌面长按快捷方式用 res/xml/shortcuts.xml 静态声明，无需权限）、
      读取应用列表（QUERY_ALL_PACKAGES）、定位、相机、麦克风、通讯录等。
      下拉栏快捷磁贴也不增加 uses-permission：BIND_QUICK_SETTINGS_TILE 是加在
      <service> 上供系统绑定的权限，不是应用自行申请的。
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TouchLock">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 长按桌面图标出现的静态快捷方式（进设置） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          设置页：exported=true 是 launcher 启动静态 shortcut 的必要条件；
          不配 intent-filter，因此外部无法通过隐式 Intent 唤起。
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title" />

        <service
            android:name=".TouchLockService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="touch_lock_overlay" />
        </service>

        <!--
          下拉栏快捷磁贴：点一下即开始倒数锁定，等同于点桌面图标。
          必须 exported=true 且由系统凭 BIND_QUICK_SETTINGS_TILE 绑定，外部应用无法直接唤起。
          icon 复用通知栏的白底锁剪影：磁贴与通知小图标同样要求白色单色 + 透明底，系统会自行着色。
        -->
        <service
            android:name=".LockTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
