<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页：ScrollView + 垂直 LinearLayout + 7 张卡片（卡片样式见 themes.xml 的 SettingsCard）。
  全部使用平台控件，不引入 AndroidX / Material Components。
  文案中带 id 的控件由 SettingsActivity 在运行时填充。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/settings_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 卡片 1：悬浮窗权限引导 -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsCardTitle"
                android:text="@string/settings_overlay_title" />

            <TextView
                android:id="@+id/overlayStatusText"
                style="@style/SettingsCardBody"
                android:textColor="@color/settings_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                style="@style/SettingsCardBody"
                android:text="@string/settings_overlay_paths_title" />

            <TextView
                android:id="@+id/overlayPathsText"
                style="@style/SettingsCardBody" />

            <Button
                android:id="@+id/overlayGoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_overlay_go" />

        </LinearLayout>

        <!-- 卡片 2：锁定倒计时 -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsCardTitle"
                android:text="@string/settings_delay_title" />

            <TextView
                android:id="@+id/delayValueText"
                style="@style/SettingsCardBody"
                android:textColor="@color/settings_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/delaySeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="30" />

            <TextView
                style="@style/SettingsCardBody"
                android:text="@string/settings_delay_hint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/delayNowButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/settings_delay_now"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/delay1Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/settings_delay_1"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/delay5Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/settings_delay_5"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/delay10Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/settings_delay_10"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 卡片 3：再次进入设置的路径（授权后点图标不再进本页，必须留下找回方式） -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsCardTitle"
                android:text="@string/settings_reenter_title" />

            <TextView
                style="@style/SettingsCardBody"
                android:text="@string/settings_reenter_body" />

        </LinearLayout>

        <!-- 卡片 4：通知权限（仅 Android 13+ 显示，由代码控制 visibility） -->
        <LinearLayout
            android:id="@+id/notifyCard"
            style="@style/SettingsCard"
            android:visibility="gone">

            <TextView
                style="@style/SettingsCardTitle"
                android:text="@string/settings_notify_title" />

            <TextView
                android:id="@+id/notifyStatusText"
                style="@style/SettingsCardBody"
                android:textColor="@color/settings_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                style="@style/SettingsCardBody"
                android:text="@string/settings_notify_hint" />

            <Button
                android:id="@+id/notifyGoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_notify_go" />

        </LinearLayout>

        <!--
          卡片 5：抽屉守卫（可选的无障碍功能，仅 Android 12+ 显示，由代码控制 visibility）
          开与不开的代价写在卡片里，让用户自己判断值不值得为了拦下拉栏去授予无障碍权限。
        -->
        <LinearLayout
            android:id="@+id/guardCard"
            style="@style/SettingsCard"
            android:visibility="gone">

            <TextView
                style="@style/SettingsCardTitle"
                android:text="@string/settings_guard_title" />

            <TextView
                android:id="@+id/guardStatusText"
                style="@style/SettingsCardBody"
                android:textColor="@color/settings_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/guardSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_guard_switch" />

            <TextView
                style="@style/SettingsCardBody"
                android:text="@string/settings_guard_diff_title" />

            <TextView
                android:id="@+id/guardDiffText"
                style="@style/SettingsCardBody" />

            <TextView
                style="@style/SettingsCardBody"
                android:text="@string/settings_guard_cost_title" />

            <TextView
                android:id="@+id/guardCostText"
                style="@style/SettingsCardBody" />

            <Button
                android:id="@+id/guardGoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_guard_go" />

        </LinearLayout>

        <!-- 卡片 6：能力边界（只读说明） -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsCardTitle"
                android:text="@string/settings_limit_title" />

            <TextView
                style="@style/SettingsCardBody"
                android:text="@string/settings_limit_body" />

        </LinearLayout>

        <!-- 卡片 7：关于 -->
        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsCardTitle"
                android:text="@string/settings_about_title" />

            <TextView
                android:id="@+id/aboutVersionText"
                style="@style/SettingsCardBody" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
